{
  "expo": {
    "name": "Funga",
    "slug": "whats-that-mushroom",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f3ea"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.co.funga.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to photograph mushrooms for identification.",
        "NSPhotoLibraryUsageDescription": "Used to choose an existing photograph of a mushroom.",
        "NSLocationWhenInUseUsageDescription": "Location and season substantially narrow which species are possible, which makes identification more reliable."
      }
    },
    "android": {
      "package": "uk.co.funga.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f6f3ea"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-location"
    ]
  }
}
