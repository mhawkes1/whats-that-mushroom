# Datasets and model artefacts — never committed, often gigabytes
data/raw/
data/processed/
data/images/
# Training outputs. The checkpoints are ~330 MB each and GitHub refuses
# anything over 100 MB, so the directory is ignored by default -- but the
# run-book's step 9 says to COMMIT the small text artefacts, because they
# are the evidence for the release decision. Those are un-ignored below.
#
# Without the negations this rule silently swallowed MODEL_CARD.md and
# report.json on the first real run, at the point where the pod was still
# billing and the files existed nowhere else.
ml/runs/**
!ml/runs/
!ml/runs/*/
!ml/runs/*/MODEL_CARD.md
!ml/runs/*/report.json
!ml/runs/*/calibration.json
!ml/runs/*/labels.json
!ml/runs/*/config.yaml
!ml/runs/*/history.json
*.parquet
*.pt
*.pth
*.onnx
*.tflite

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node / Expo
node_modules/
.expo/
dist/
*.log

# Secrets
.env
.env.*
!.env.example

# Incident reports are real user data, never committed
data/incidents*.jsonl

# scripts/try_it.sh keeps its service logs here
.try_it_api.log
.try_it_web.log
