# API base URL used by the Expo client. Must be reachable from the phone,
# so "localhost" will not work on a physical device -- use your LAN IP.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Server overrides (all optional; see server/app/config.py for defaults).
# WTM_MODEL_PATH=/srv/models/model.onnx
# WTM_LABELS_PATH=/srv/models/labels.json
# WTM_CALIBRATION_PATH=/srv/models/calibration.json
# WTM_CONFIDENCE_THRESHOLD=0.80
